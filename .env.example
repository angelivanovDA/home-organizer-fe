# Client-visible (must be prefixed with VITE_)
# Leave empty in development to use same-origin URLs and the Vite dev proxy.
VITE_API_URL=

# Use MSW mock API instead of a real backend (recommended for FE-first development)
VITE_ENABLE_MOCK_API=true

# Dev server port (optional; defaults to 4000)
VITE_DEV_PORT=4000

# Vite dev-server proxy target only (not exposed to the browser; ignored when mocks are on)
API_PROXY_TARGET=http://localhost:3000
